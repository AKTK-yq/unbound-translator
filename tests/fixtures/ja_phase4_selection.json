{
  "entries": [
    {"id": "scr_1F0F79C", "japanese": "これで ボーリウスちほうへの たびの じゅんびは ほぼ できました。 でも その まえに\\.", "route": "intro"},
    {"id": "scr_1F0F7EC", "japanese": "キャラを えらんで ください。", "route": "intro", "expected": "in-place"},
    {"id": "scr_1F0F800", "japanese": "はだの いろを えらんで", "route": "intro"},
    {"id": "scr_1F0F814", "japanese": "かみの いろを えらんで", "route": "intro"},
    {"id": "scr_1F0F82A", "japanese": "ジャケットの いろを えらんで", "route": "intro"},
    {"id": "scr_1F0F842", "japanese": "ふちのいろをえらんで", "route": "intro"},
    {"id": "scr_1F0F858", "japanese": "この キャラで あそびますか？", "route": "intro"},
    {"id": "scr_1F0F874", "japanese": "さいごに あなたの なまえを おしえて ください。", "route": "intro"},
    {"id": "scr_1F0F89C", "japanese": "[player]で よろしいですか？", "route": "intro"},
    {"id": "scr_1F0F8AD", "japanese": "つぎは あなたに あった あそびかたを きめましょう。 ポケモン アンバウンドを あそぶのは はじめてですか？", "route": "intro"},
    {"id": "scr_1F0F91A", "japanese": "Eclipse, GPemu, JohnGBA, No$GBAの どれかを つかって いますか？", "route": "intro"},
    {"id": "scr_1F0F9DD", "japanese": "レポートを かきわすれがちですか？", "route": "intro"},
    {"id": "scr_1F0F9FA", "japanese": "むずかしい なぞときは すきですか？ こっそり すすんだり いわを おしたり する なぞときも あります。", "route": "intro"},
    {"id": "scr_1F0FA63", "japanese": "フェアリータイプは どくタイプに よわい などの タイプあいしょうを しって いますか？", "route": "intro"},
    {"id": "scr_1F0FB2B", "japanese": "バトルを あまり きにせず きがるに あそびたいですか？", "route": "intro"},
    {"id": "scr_1F0FB85", "japanese": "ときどき あたらしい ポケモンを そだてて チームに いれても だいじょうぶですか？", "route": "intro"},
    {"id": "scr_1F0FC3F", "japanese": "[green][buffer1][black]が あなたへの おすすめの むずかしさです。 もっと うえの むずかしさも えらべますが たのしめなく なるかも しれません。 [green][buffer1][black]で つづけますか？", "route": "intro"},
    {"id": "scr_1F0FE27", "japanese": "なぞときの むずかしさを えらんで ください。 むずかしいほど あたまを つかう なぞときや こっそり すすむ なぞときが てごわく なります。", "route": "intro"},
    {"id": "scr_1F0FF35", "japanese": "バトルの むずかしさを えらんで ください。 むずかしいほど トレーナーは つよく やせいの ポケモンは かしこく なります。", "route": "intro"},
    {"id": "scr_1F10323", "japanese": "ゲームの むずかしさは [green][buffer1][black]に なりました。 せっていで いつでも Vanillaと Difficultを きりかえられます。", "route": "intro"},
    {"id": "scr_740088", "japanese": "ねえ きみ！ おばあちゃんの ばんごはんは とっても おいしいんだ！ こんど たべて いってよ！", "route": "npc"},
    {"id": "scr_7401A9", "japanese": "パパが うちの ポケモンを たくさん きたえたんだ！ いまは すごく つよいよ！", "route": "npc"},
    {"id": "scr_740753", "japanese": "あなたが ママなの？", "route": "npc"},
    {"id": "scr_74145B", "japanese": "やあーーー\\.ジムに ちょうせんしに きたのかい？", "route": "npc"},
    {"id": "scr_744C3D", "japanese": "ふしぎな かたちの はっぱを した しょくぶつだ。", "route": "npc"},
    {"id": "scr_744F54", "japanese": "たびびとに しんせつに するのが すきでね。 しゅみの ひとつなんだ。", "route": "npc"},
    {"id": "scr_7450DB", "japanese": "みてみて！ ここから デハラシティが みえるよ！", "route": "npc"},
    {"id": "scr_745D0D", "japanese": "じゃあ はじめよう！", "route": "npc"},
    {"id": "scr_745D25", "japanese": "いい バトルだったね！ ポケモンも たのしそうだった！", "route": "npc"},
